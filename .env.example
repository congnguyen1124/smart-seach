APP_ENV=development

# Lightweight, deterministic provider used until pgvector is connected.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-demo-v1
EMBEDDING_DIMENSION=384

DEFAULT_SEARCH_THRESHOLD=0.15
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50
SEARCH_CANDIDATE_MULTIPLIER=5

# Reserved for the later PostgreSQL + pgvector adapter.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/smart_search
