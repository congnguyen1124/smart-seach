APP_ENV=development

STORAGE_BACKEND=postgres
POSTGRES_USER=smart_search
POSTGRES_PASSWORD=smart_search
POSTGRES_DB=smart_search
POSTGRES_PORT=5432
DATABASE_URL=postgresql://smart_search:smart_search@db:5432/smart_search
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Lightweight, deterministic provider for local development.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-demo-v1
EMBEDDING_DIMENSION=768

DEFAULT_SEARCH_THRESHOLD=0.15
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50
SEARCH_CANDIDATE_MULTIPLIER=5
